                "workBpm": {
                    "type": "integer"
                },
                "workReps": {
                    "type": "integer"
                }
            },
            "required": [
                "colorId",
                "coolDown",
                "cycles",
                "doNotRepeatFirstPrepareAndLastCoolDown",
                "id",
                "intervalsSetsCount",
                "isFavorite",
                "isRestRepsMode",
                "isWorkRepsMode",
                "prepare",
                "rest",
                "restBetweenTabatas",
                "restBetweenWorkoutsReps",
                "restBetweenWorkoutsRepsMode",
                "restBetweenWorkoutsTime",
                "restBpm",
                "restReps",
                "skipLastRestInterval",
                "skipPrepareAndCoolDownBetweenWorkouts",
                "tabatasCount",
                "title",
                "work",
                "workBpm",
                "workReps"
            ],
            "title": "Workout"
        }
    }
